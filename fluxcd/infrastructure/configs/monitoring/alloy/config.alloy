discovery.kubernetes "pod" {
  role = "pod"
}

discovery.relabel "api_pod" {
  targets = discovery.kubernetes.pod.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    regex         = "api"
    action        = "keep"
  }
}

loki.source.kubernetes "podlog" {
  targets    = discovery.relabel.api_pod.output
  forward_to = [loki.write.grafana_loki.receiver]
}

loki.write "grafana_loki" {
  endpoint {
    url = "http://grafana-loki.monitoring.svc.cluster.local:3100/api/v1/push"
  }
}
